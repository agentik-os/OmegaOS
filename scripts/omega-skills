#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# omega-skills — list & search every skill in the system and how to run it.
# Reads ~/.omega/skills-atlas.json (rebuild: python3 <atlas-generator>).
#   omega-skills                list all native OmegaOS skills + commands
#   omega-skills <term>         search native skills (name/desc/command)
#   omega-skills --powerups <t> search the Power-Up library (907 paid skills)
#   omega-skills --all <term>   search both
#   omega-skills --rag "<need>" SEMANTIC retrieval by meaning (native + library)
#   omega-skills --html         print the served catalog URL
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail
OMEGA_DIR="${OMEGA_DIR:-$HOME/.omega}"
ATLAS="$OMEGA_DIR/skills-atlas.json"
CATALOG="${OMEGA_SKILL_CATALOG:-$OMEGA_DIR/skill-catalog-v1.json}"
ATLAS_GENERATOR="$OMEGA_DIR/bin/omega-skills-atlas.py"
URL="https://station.tail64d114.ts.net:8443/omega-skill-atlas.html"

# Rebuild when the canonical compiler digest changes. During staged migration,
# legacy installs without SkillCatalogV1 use the newest SKILL.md mtime as their
# drift signal. A failed rebuild is surfaced rather than serving a stale Atlas.
if python3 - "$ATLAS" "$CATALOG" "$OMEGA_DIR/skills" <<'PY'
import json, os, sys
atlas_path, catalog_path, skills_root = sys.argv[1:]
if not os.path.isfile(atlas_path):
    raise SystemExit(0)
try:
    atlas = json.load(open(atlas_path, encoding="utf-8"))
except Exception:
    raise SystemExit(0)
if os.path.isfile(catalog_path):
    try:
        catalog = json.load(open(catalog_path, encoding="utf-8"))
    except Exception:
        raise SystemExit(0)
    raise SystemExit(0 if atlas.get("catalog_hash") != catalog.get("content_digest") else 1)
atlas_mtime = os.path.getmtime(atlas_path)
excluded = {".git", ".venv", "build", "dist", "node_modules", "target", "vendor"}
for current, dirs, files in os.walk(skills_root, topdown=True, followlinks=False):
    dirs[:] = [d for d in dirs if d not in excluded and
               not os.path.islink(os.path.join(current, d))]
    if "SKILL.md" in files and os.path.getmtime(os.path.join(current, "SKILL.md")) > atlas_mtime:
        raise SystemExit(0)
raise SystemExit(1)
PY
then
    [ -f "$ATLAS_GENERATOR" ] || {
        echo "skill Atlas is stale and generator is unavailable: $ATLAS_GENERATOR" >&2
        exit 1
    }
    python3 "$ATLAS_GENERATOR" >/dev/null
fi
[ -f "$ATLAS" ] || { echo "atlas not found and could not be built: $ATLAS" >&2; exit 1; }

if [ "${1:-}" = "--html" ]; then echo "$URL"; exit 0; fi

# Semantic RAG: retrieve by MEANING across the whole corpus (native + library).
if [ "${1:-}" = "--rag" ]; then
    shift
    RAG="$OMEGA_DIR/bin/omega-skills-rag.py"
    [ -f "$RAG" ] || { echo "rag backend not found: $RAG" >&2; exit 1; }
    exec python3 "$RAG" query "$@"
fi

SCOPE="native"; TERM=""
case "${1:-}" in
  --powerups) SCOPE="powerups"; TERM="${2:-}";;
  --all)      SCOPE="all";      TERM="${2:-}";;
  "")         SCOPE="native";   TERM="";;
  *)          SCOPE="native";   TERM="$1";;
esac

python3 - "$ATLAS" "$SCOPE" "$TERM" <<'PY'
import json,sys,re
atlas,scope,term=json.load(open(sys.argv[1])),sys.argv[2],sys.argv[3].lower()
rows=[]
if scope in ("native","all"):
    for r in atlas["native"]:
        rows.append((r["name"]," ".join(r["commands"]),r.get("description","") or "","omegaos"))
if scope in ("powerups","all"):
    for r in atlas["powerups"]:
        rows.append((r["name"],"","(library) "+r.get("description","") ,r["source"]))
def hit(row): return not term or term in row[0].lower() or term in row[2].lower() or term in row[1].lower()
rows=[r for r in rows if hit(r)]
rows.sort(key=lambda r:(r[3]!="omegaos",r[0].lower()))
w=max((len(r[0]) for r in rows),default=10)
cw=max((len(r[1]) for r in rows),default=8)
for name,cmd,desc,src in rows:
    d=re.sub(r"\s+"," ",desc).strip()
    print(f"\033[1m{name.ljust(w)}\033[0m  \033[36m{cmd.ljust(cw)}\033[0m  {d[:96]}")
print(f"\n{len(rows)} skill(s) · scope={scope}"+(f" · term='{term}'" if term else ""))
print("Full catalog: https://station.tail64d114.ts.net:8443/omega-skill-atlas.html")
PY
