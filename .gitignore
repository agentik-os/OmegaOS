/target
# Cargo.lock IS committed — this is a binary/app workspace, so the lockfile is
# what makes a fresh `git clone && cargo build --locked` reproducible.
*.swp
*.swo
.DS_Store

# User config — contains secrets (bot tokens, API keys)
.omega/
telegram.toml
*.env
*.env.*
.env.local
tools/pdfgen/node_modules/
tools/pdfgen/.next/
tools/pdfgen/output/
.claude/worktrees/
audits/.*/

# Python bytecode (never ship — embeds absolute source paths)
__pycache__/
*.pyc

# OmegaMC dashboard — separate repo (agentik-os/agentik-telegram), MIT (M. Tzanidakis)
mission-control/

# OmegaOS hygiene — agent/test artifacts (auto-added)
.audit/
.code/
.linear-fix/
.orchestrator/
playwright-report/
test-results/
.playwright-mcp/
.planner-cache/
