# OmegaOS rmux integration
# Source from your ~/.rmux.conf with:
#   source-file ~/.omega/rmux.conf.omega
#
# This adds the Option+Z (Alt+Z) keybinding to launch the OmegaOS
# session manager as a popup over any rmux session.

# Keep the FULL conversation scrollback for agent sessions. The rmux default
# (2000 lines) silently discards the top of long chats; OmegaOS lets you
# scroll all the way back, so retain a large history. Set here so it persists
# across daemon restarts (the omega binary also sets it at startup as a
# fallback for daemons that began before this config was sourced).
set-option -g history-limit 100000

# Localized status-bar clock. rmux's built-in `%H:%M` strftime uses the rmux
# SERVER's timezone, which is UTC on a headless VPS — so the clock reads hours
# off from the operator's wall time. Instead, render it via `omega clock`, which
# honors the `timezone` field in ~/.omega/config.toml (one source of truth,
# shared with the TUI clock). Refreshed every status-interval; falls back to
# the system `date` if the omega binary isn't on the server's PATH.
set-option -g status-interval 15
set-option -g status-right "\"#{=21:pane_title}\" #(omega clock --full 2>/dev/null || date '+%H:%M %d-%b-%y')"

# Option/Alt + Up/Down — scroll the pane's scrollback by one line (the
# tmux-default user UX). If the pane is already in copy/view-mode, just
# scroll. Otherwise, enter copy-mode with -e (auto-exits when you scroll
# back to the bottom) then scroll one line. Matches what desktop tmux users
# are used to inside Claude sessions, without touching rmux internals.
#
# Does NOT break the omega TUI: that app intercepts Alt+Up via crossterm
# BEFORE rmux ever sees a key (when the user is in the omega TUI, the
# foreground binary is the TUI itself); these root bindings only fire when
# the user is attached directly to a session, which is exactly the case the
# tmux-style scroll is meant for.
#
# Mobile (Termius without rmux on top) is unaffected — rmux is not in the
# pipeline there, so PageUp/Down super-scroll keeps working unchanged.
#
# NOTE: quoted-string if-shell form (cmd-true / cmd-false as quoted args), NOT
# the brace `{ … }` command-list form — rmux 0.3.1 rejects braces here with
# "bind-key does not accept a parsed command-list argument", which silently
# drops the binding so Alt+Up/Down scroll never works on a fresh install.
bind-key -n M-Up   if-shell -F '#{pane_in_mode}' 'send-keys -X scroll-up'   'copy-mode -e ; send-keys -X scroll-up'
bind-key -n M-Down if-shell -F '#{pane_in_mode}' 'send-keys -X scroll-down' 'copy-mode -e ; send-keys -X scroll-down'

# Option+Z / Alt+Z → OmegaOS session manager popup (full-screen)
bind-key -n M-z display-popup -E -w 100% -h 100% "omega menu"

# Option+/ → alias for omega menu
bind-key -n M-/ display-popup -E -w 100% -h 100% "omega menu"

# Prefix + o → omega menu (works even on terminals that swallow Alt)
bind-key o display-popup -E -w 100% -h 100% "omega menu"

# Prefix + O → dispatch oracle (interactive)
bind-key O display-popup -E -w 80% -h 30% "read -p 'Project: ' p && read -p 'Mission: ' m && omega dispatch \"\$p\" \"\$m\""

# Prefix + L → omega list (in-place)
bind-key L display-popup -E -w 80% -h 60% "omega list; read -p 'Press Enter to close...'"

# Prefix + P → omega patrol once
bind-key P display-popup -E -w 80% -h 40% "omega patrol --once; read -p 'Press Enter to close...'"
