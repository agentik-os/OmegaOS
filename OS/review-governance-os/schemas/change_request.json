{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Change Request",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "problem": {
      "type": "string",
      "description": "Problem/evidence"
    },
    "proposed_change": {
      "type": "string",
      "description": "Change"
    },
    "risk_level": {
      "type": "string",
      "description": "Risk"
    },
    "test_plan": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tests"
    },
    "rollback_plan": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Rollback"
    },
    "approval_status": {
      "type": "string",
      "description": "Status"
    }
  },
  "required": [
    "id",
    "created_at",
    "problem",
    "proposed_change",
    "risk_level",
    "test_plan",
    "rollback_plan",
    "approval_status"
  ],
  "additionalProperties": false
}
