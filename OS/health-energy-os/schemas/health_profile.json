{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Health Profile",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Health and performance goals"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Medical, schedule and access constraints"
    },
    "professional_care": {
      "type": "object",
      "additionalProperties": true,
      "description": "Authorized care context"
    }
  },
  "required": [
    "id",
    "created_at",
    "goals"
  ],
  "additionalProperties": false
}
