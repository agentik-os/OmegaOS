{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Process Step",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "process_id": {
      "type": "string",
      "description": "Process"
    },
    "sequence": {
      "type": "integer",
      "description": "Order"
    },
    "actor": {
      "type": "string",
      "description": "Actor/system"
    },
    "action": {
      "type": "string",
      "description": "Action"
    },
    "input_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Inputs"
    },
    "output_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Outputs"
    },
    "processing_time": {
      "type": "number",
      "description": "Active time"
    }
  },
  "required": [
    "id",
    "created_at",
    "process_id",
    "sequence",
    "actor",
    "action"
  ],
  "additionalProperties": false
}
