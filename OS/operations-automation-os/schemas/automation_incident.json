{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automation Incident",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Affected runs"
    },
    "impact": {
      "type": "string",
      "description": "Impact"
    },
    "containment": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Containment"
    },
    "recovery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recovery"
    },
    "status": {
      "type": "string",
      "description": "Status"
    }
  },
  "required": [
    "id",
    "created_at",
    "run_ids",
    "impact",
    "containment",
    "recovery",
    "status"
  ],
  "additionalProperties": false
}
