{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automation Candidate",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "process_id": {
      "type": "string",
      "description": "Process"
    },
    "scope": {
      "type": "string",
      "description": "Candidate scope"
    },
    "scores": {
      "type": "object",
      "additionalProperties": true,
      "description": "Suitability scores"
    },
    "recommendation": {
      "type": "string",
      "description": "remove/simplify/delegate/automate/reject"
    },
    "risk_level": {
      "type": "string",
      "description": "Risk"
    }
  },
  "required": [
    "id",
    "created_at",
    "process_id",
    "scope",
    "scores",
    "recommendation",
    "risk_level"
  ],
  "additionalProperties": false
}
