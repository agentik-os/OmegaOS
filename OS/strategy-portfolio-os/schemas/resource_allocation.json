{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resource Allocation",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "resource_type": {
      "type": "string",
      "description": "time/capital/people/attention"
    },
    "amount": {
      "type": "number",
      "description": "Allocated amount"
    },
    "unit": {
      "type": "string",
      "description": "Unit"
    },
    "period": {
      "type": "string",
      "description": "Period"
    }
  },
  "required": [
    "id",
    "created_at",
    "resource_type",
    "amount",
    "unit",
    "period"
  ],
  "additionalProperties": false
}
