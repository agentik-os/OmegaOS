{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "name": {
      "type": "string",
      "description": "Scenario"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Assumptions"
    },
    "signposts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Signals"
    },
    "contingent_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Responses"
    }
  },
  "required": [
    "id",
    "created_at",
    "name",
    "assumptions",
    "signposts",
    "contingent_actions"
  ],
  "additionalProperties": false
}
