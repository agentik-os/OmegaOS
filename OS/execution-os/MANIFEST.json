  "events": {
    "produces": [
      {
        "event": "execution.outcome.proven",
        "payload_note": "A closed outcome record proven against its finish line: outcome id, domain, definition of done, and the observable evidence/acceptance that satisfied it. Consumed by Strategy & Portfolio OS and Review & Governance OS.",
        "consumers": [
          "Strategy & Portfolio OS",
          "Review & Governance OS"
        ]
      },
      {
        "event": "execution.commitment.closed",
        "payload_note": "A closed commitment: commitment id, linked outcome, completion classification (SHIPPED, VERIFIED, PROGRESSED, TOUCHED, ABANDONED), and the evidence captured at close."
      }
    ],
    "consumes": [
      {
        "event": "strategy.execution_packet.created",
        "source": "Strategy & Portfolio OS",
        "note": "Personal-execute branch entry point: quarterly outcomes and exclusions packet."
      },
      {
        "event": "handoff.execution.capacity",
        "source": "Health & Energy OS",
        "note": "Capacity status and workload constraints used to plan from real time and energy."
      },
      {
        "event": "relationship.followup.drafted",
        "source": "Relationship & Network OS",
        "note": "Follow-up tasks to schedule as commitments."
      }
    ]
  },
  "state_classification": {
    "canonical": "Closed commitments with proof and weekly/quarterly reviews route through Context & Memory OS.",
    "local_operational": "scripts/execution_engine.py holds today's single-thread focus state and in-progress drafts as a local projection, never a competing source of truth for closed commitments.",
    "read": "memory.context.compiled",
    "write": "memory.record.staged (Context & Memory OS returns memory.record.verified)"
  },
  "handoffs": [
    "Strategy & Portfolio OS (provides strategy.execution_packet.created, receives execution.outcome.proven)",
    "Health & Energy OS (provides handoff.execution.capacity)",
    "Review & Governance OS (receives execution evidence, owns change control)",
    "Relationship & Network OS (provides relationship.followup.drafted)",
    "Mindset OS (identity, values, framing)",
    "Habit Tracker OS (repeated-behavior data and streaks)"
  ],
  "installation": "See OMEGA_INTEGRATION.md for the registration contract, context injection order, event wiring, and state classification.",
  "schema_version": 1
}
