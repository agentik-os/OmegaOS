{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Pillar",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "audience": {
      "type": "string",
      "description": "Audience"
    },
    "problem": {
      "type": "string",
      "description": "Problem"
    },
    "thesis": {
      "type": "string",
      "description": "Core thesis"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence/source material"
    },
    "format": {
      "type": "string",
      "description": "Pillar format"
    }
  },
  "required": [
    "id",
    "created_at",
    "audience",
    "problem",
    "thesis",
    "source_ids",
    "format"
  ],
  "additionalProperties": false
}
