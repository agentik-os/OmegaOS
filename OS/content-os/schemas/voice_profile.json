{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voice Profile",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Authentic voice traits"
    },
    "preferred_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Approved patterns"
    },
    "forbidden_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Anti-style"
    },
    "sample_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Approved samples"
    }
  },
  "required": [
    "id",
    "created_at",
    "traits",
    "forbidden_patterns",
    "sample_source_ids"
  ],
  "additionalProperties": false
}
