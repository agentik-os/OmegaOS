{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Atom",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "atom_type": {
      "type": "string",
      "description": "claim/story/proof/framework/question/scene"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Provenance"
    },
    "core_idea": {
      "type": "string",
      "description": "Atomic insight"
    },
    "privacy_status": {
      "type": "string",
      "description": "usable/consent-needed/private"
    }
  },
  "required": [
    "id",
    "created_at",
    "atom_type",
    "source_ids",
    "core_idea",
    "privacy_status"
  ],
  "additionalProperties": false
}
