{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production Job",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "asset_id": {
      "type": "string",
      "description": "Asset"
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Deliverables"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dependencies"
    },
    "owner": {
      "type": "string",
      "description": "Owner"
    },
    "approval_status": {
      "type": "string",
      "description": "Approval"
    }
  },
  "required": [
    "id",
    "created_at",
    "asset_id",
    "deliverables",
    "owner",
    "approval_status"
  ],
  "additionalProperties": false
}
