{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Financial Document",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "document_type": {
      "type": "string",
      "description": "Statement/receipt/tax/etc."
    },
    "file_hash": {
      "type": "string",
      "description": "Deduplication hash"
    },
    "extraction_status": {
      "type": "string",
      "description": "staged/verified/rejected"
    }
  },
  "required": [
    "id",
    "created_at",
    "document_type",
    "file_hash",
    "extraction_status"
  ],
  "additionalProperties": false
}
