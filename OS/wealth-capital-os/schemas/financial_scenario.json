{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Financial Scenario",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "name": {
      "type": "string",
      "description": "Scenario name"
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Explicit assumptions"
    },
    "results": {
      "type": "object",
      "additionalProperties": true,
      "description": "Modeled outputs"
    }
  },
  "required": [
    "id",
    "created_at",
    "name",
    "assumptions",
    "results"
  ],
  "additionalProperties": false
}
