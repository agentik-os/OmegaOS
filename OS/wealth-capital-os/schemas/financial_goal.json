{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Financial Goal",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "name": {
      "type": "string",
      "description": "Goal"
    },
    "target_amount": {
      "type": "number",
      "description": "Target amount"
    },
    "target_date": {
      "type": "string",
      "description": "Target date"
    },
    "priority": {
      "type": "string",
      "description": "Priority"
    }
  },
  "required": [
    "id",
    "created_at",
    "name",
    "priority"
  ],
  "additionalProperties": false
}
