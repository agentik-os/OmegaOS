      },
      {
        "command": "omega-mindset coach <workspace> [--arm | --disarm]",
        "purpose": "Run one evidence-aware coaching pass now (scripts/auto_coach.sh); --arm installs the daily 07:00 cron, --disarm removes it. Disarmed by default."
