        "command": "scripts/score_week.py <weekly-scorecard.json>",
        "purpose": "Validate and summarize a Mindset OS weekly scorecard."
      },
      {
        "command": "scripts/six_month_challenge.py --name \"<name>\" --output <dir> [--start YYYY-MM-DD] [--force]",
