  "commands": {
    "skill": [
      {
        "command": "/stepper-os",
        "aliases": [
          "/stepper",
          "/omg-stepper-os"
        ],
        "purpose": "Enter the Stepper execution loop"
      }
    ],
    "cli": [
      {
        "command": "omega-stepper init --name <name>",
        "purpose": "Create a new Stepper project"
      },
      {
        "command": "omega-stepper validate",
        "purpose": "Check schema, the acyclic graph, and that every Blueprint/Design reference resolves"
      },
      {
        "command": "omega-stepper resume",
        "purpose": "Reconcile interrupted attempts, recover exact state"
      },
      {
        "command": "omega-stepper status",
        "purpose": "Weighted plus raw progress"
      },
      {
        "command": "omega-stepper plan",
        "purpose": "Ranked READY candidates and the safe wave"
      },
      {
        "command": "omega-stepper start <STEP-ID>",
        "purpose": "Claim a step and print its full agent brief"
      },
      {
        "command": "omega-stepper done <STEP-ID>",
        "purpose": "Close a step through the deterministic verifier (PASS or FAIL)"
      },
      {
        "command": "omega-stepper review <STEP-ID> <role> PASS --by <name>",
        "purpose": "Record a required review gate"
      },
      {
        "command": "omega-stepper release-check",
        "purpose": "The finish gate, must PASS before a release"
      },
      {
        "command": "omega-stepper report",
        "purpose": "Report progress"
      }
    ]
