#!/usr/bin/env bash
# omega-align — the OmegaOS command for Alignment OS (AgentikOS suite, personal
# group; Alignment Coach {OS}). This OS is conversational (no CLI engine): the
# wrapper opens a Claude session running the Alignment master agent, working
# from the OS folder so its memory ledger persists. The coaching happens in the
# agent (/coach · /align), or via the OS's Telegram bot.
set -euo pipefail

OMEGA_DIR="${OMEGA_DIR:-$HOME/.omega}"
OS_DIR="$OMEGA_DIR/os/alignment-os"
mkdir -p "$OS_DIR/ledger"

PERSONA="$OS_DIR/MASTER.md"
[[ -f "$PERSONA" ]] || {
    echo "omega-align: no master persona at $PERSONA — run OmegaOS install.sh" >&2
    exit 1
}

cd "$OS_DIR"
exec claude --append-system-prompt "$(cat "$PERSONA")" "$@"
