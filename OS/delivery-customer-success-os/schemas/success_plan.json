{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Success Plan",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "engagement_id": {
      "type": "string",
      "description": "Engagement"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Desired outcomes"
    },
    "baselines": {
      "type": "object",
      "additionalProperties": true,
      "description": "Starting values"
    },
    "measures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Success measures"
    },
    "owners": {
      "type": "object",
      "additionalProperties": true,
      "description": "Ownership"
    }
  },
  "required": [
    "id",
    "created_at",
    "engagement_id",
    "outcomes",
    "measures",
    "owners"
  ],
  "additionalProperties": false
}
