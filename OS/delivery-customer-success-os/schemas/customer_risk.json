{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer Risk",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "engagement_id": {
      "type": "string",
      "description": "Engagement"
    },
    "description": {
      "type": "string",
      "description": "Risk"
    },
    "impact": {
      "type": "string",
      "description": "Impact"
    },
    "owner": {
      "type": "string",
      "description": "Owner"
    },
    "mitigation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Actions"
    },
    "status": {
      "type": "string",
      "description": "Status"
    }
  },
  "required": [
    "id",
    "created_at",
    "engagement_id",
    "description",
    "impact",
    "owner",
    "mitigation",
    "status"
  ],
  "additionalProperties": false
}
