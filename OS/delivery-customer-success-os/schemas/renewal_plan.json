{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Renewal Plan",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "engagement_id": {
      "type": "string",
      "description": "Engagement"
    },
    "decision_date": {
      "type": "string",
      "description": "Customer decision date"
    },
    "value_summary": {
      "type": "string",
      "description": "Value"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Risks"
    },
    "next_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Next outcomes"
    }
  },
  "required": [
    "id",
    "created_at",
    "engagement_id",
    "decision_date",
    "value_summary",
    "next_outcomes"
  ],
  "additionalProperties": false
}
