{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Milestone",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "engagement_id": {
      "type": "string",
      "description": "Engagement"
    },
    "name": {
      "type": "string",
      "description": "Milestone"
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Outputs"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Criteria"
    },
    "status": {
      "type": "string",
      "description": "Status"
    }
  },
  "required": [
    "id",
    "created_at",
    "engagement_id",
    "name",
    "deliverables",
    "acceptance_criteria",
    "status"
  ],
  "additionalProperties": false
}
