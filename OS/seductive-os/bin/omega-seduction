#!/usr/bin/env bash
# omega-seduction — the OmegaOS command for Seductive OS (AgentikOS suite,
# personal group; Seductive {OS}). This OS is conversational (no CLI engine):
# the wrapper opens a Claude session running the Seductive master agent,
# working from the OS folder so its consent-gated memory ledger persists. The
# coaching happens in the agent (/seduction · /charisma), or via the OS's
# Telegram bot.
set -euo pipefail

OMEGA_DIR="${OMEGA_DIR:-$HOME/.omega}"
OS_DIR="$OMEGA_DIR/os/seductive-os"
mkdir -p "$OS_DIR/ledger"

PERSONA="$OS_DIR/MASTER.md"
[[ -f "$PERSONA" ]] || {
    echo "omega-seduction: no master persona at $PERSONA — run OmegaOS install.sh" >&2
    exit 1
}

cd "$OS_DIR"
exec claude --append-system-prompt "$(cat "$PERSONA")" "$@"
