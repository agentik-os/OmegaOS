{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "os-manifest.schema.json",
  "title": "AgentikOSManifest",
  "type": "object",
  "required": [
    "name",
    "slug",
    "version",
    "purpose",
    "capabilities",
    "commands",
    "workflows",
    "boundaries"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "memory": {
      "type": "object"
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object"
    },
    "release": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
