{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "ClaimRecord",
  "type": "object",
  "required": [
    "claim_id",
    "statement",
    "claim_type",
    "status",
    "confidence",
    "supporting_sources"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "enum": [
        "empirical",
        "conceptual",
        "procedural",
        "normative",
        "design"
      ]
    },
    "status": {
      "enum": [
        "accepted",
        "conditional",
        "disputed",
        "rejected",
        "insufficient",
        "outdated"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "supporting_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradicting_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "population": {
      "type": [
        "string",
        "null"
      ]
    },
    "context": {
      "type": [
        "string",
        "null"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recency": {
      "type": [
        "string",
        "null"
      ]
    },
    "implementation_implications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
