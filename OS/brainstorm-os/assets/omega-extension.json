{
  "extension": "brainstorm-os",
  "version": "3.0.0",
  "display_name": "Brainstorm {OS}",
  "role": "exploration-and-decision-compiler",
  "entrypoint": "SKILL.md",
  "state_schema": "assets/session.schema.json",
  "council_profiles": "assets/council-profiles.json",
  "cli": "scripts/brainstorm_os.py",
  "commands": [
    "/brainstorm",
    "/ideate",
    "/frame-fission",
    "/signature",
    "/genome",
    "/evolve",
    "/collision",
    "/worlds",
    "/anomaly",
    "/incubate",
    "/portfolio",
    "/surface",
    "/challenge",
    "/expand",
    "/mutate",
    "/reframe",
    "/redteam",
    "/council",
    "/research",
    "/compare",
    "/converge",
    "/experiment",
    "/audit",
    "/freeze",
    "/handoff",
    "/continue"
  ],
  "events": [
    "brainstorm.session.started",
    "brainstorm.frame.fissioned",
    "brainstorm.generation.completed",
    "brainstorm.surface.selected",
    "brainstorm.idea.incubated",
    "brainstorm.round.completed",
    "brainstorm.research.requested",
    "brainstorm.convergence.proposed",
    "brainstorm.concept.frozen",
    "brainstorm.handoff.research.ready",
    "brainstorm.handoff.blueprint.ready",
    "brainstorm.audit.completed"
  ],
  "upstream": ["user", "project-context", "evidence-return", "downstream-change-request"],
  "downstream": ["market-research-os", "blueprint-os", "decision-brief", "creative-brief"],
  "invariants": [
    "preserve named project boundaries",
    "independent positions precede cross-examination",
    "unsupported claims remain hypotheses",
    "rejected and superseded records remain in lineage",
    "multi-surface concepts assign non-redundant roles and canonical state ownership",
    "novelty must be causally useful and founder-intent faithful",
    "the Chair owns final adjudication",
    "no downstream implementation work is silently performed"
  ]
}
