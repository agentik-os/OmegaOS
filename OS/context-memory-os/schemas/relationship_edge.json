{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relationship Edge",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "from_entity": {
      "type": "string",
      "description": "Source entity"
    },
    "to_entity": {
      "type": "string",
      "description": "Target entity"
    },
    "relation": {
      "type": "string",
      "description": "Relationship"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Supporting sources"
    }
  },
  "required": [
    "id",
    "created_at",
    "from_entity",
    "to_entity",
    "relation",
    "evidence_ids"
  ],
  "additionalProperties": false
}
