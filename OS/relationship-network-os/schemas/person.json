{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Person",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "display_name": {
      "type": "string",
      "description": "Name used by user"
    },
    "relationship_context": {
      "type": "string",
      "description": "How the user knows the person"
    },
    "authorized_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Minimum useful notes"
    },
    "privacy_class": {
      "type": "string",
      "description": "Sensitivity"
    }
  },
  "required": [
    "id",
    "created_at",
    "display_name",
    "privacy_class"
  ],
  "additionalProperties": false
}
