{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revenue Metric",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "name": {
      "type": "string",
      "description": "Metric"
    },
    "definition": {
      "type": "string",
      "description": "Formula/meaning"
    },
    "period": {
      "type": "string",
      "description": "Period"
    },
    "value": {
      "type": "number",
      "description": "Value"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sources"
    }
  },
  "required": [
    "id",
    "created_at",
    "name",
    "definition",
    "period",
    "value",
    "source_ids"
  ],
  "additionalProperties": false
}
