{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Activity",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "customer_id": {
      "type": "string",
      "description": "Account"
    },
    "activity_type": {
      "type": "string",
      "description": "call/email/meeting/etc."
    },
    "occurred_at": {
      "type": "string",
      "description": "Time"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Facts"
    },
    "commitments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Commitments"
    }
  },
  "required": [
    "id",
    "created_at",
    "customer_id",
    "activity_type",
    "occurred_at"
  ],
  "additionalProperties": false
}
