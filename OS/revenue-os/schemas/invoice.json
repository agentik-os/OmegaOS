{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invoice",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "customer_id": {
      "type": "string",
      "description": "Customer"
    },
    "invoice_number": {
      "type": "string",
      "description": "Number"
    },
    "issue_date": {
      "type": "string",
      "description": "Issue date"
    },
    "due_date": {
      "type": "string",
      "description": "Due date"
    },
    "amount": {
      "type": "number",
      "description": "Amount"
    },
    "currency": {
      "type": "string",
      "description": "Currency"
    },
    "status": {
      "type": "string",
      "description": "draft/sent/paid/overdue/disputed"
    }
  },
  "required": [
    "id",
    "created_at",
    "customer_id",
    "invoice_number",
    "issue_date",
    "due_date",
    "amount",
    "currency",
    "status"
  ],
  "additionalProperties": false
}
