      "thesis.checkpoint.due",
      "thesis.invalidated",
      "board.pack.published",
      "board.escalation.raised",
      "change.approved"
    ],
    "emits": [
      "portfolio.position.opened",
      "portfolio.report.published",
      "portfolio.mark.updated",
      "portfolio.followon.recommended",
      "portfolio.position.impaired",
      "portfolio.exit.ready",
      "portfolio.reallocation.proposed"
    ]
  },
  "targets": {
    "claude": {
      "supported": true
    },
    "chatgpt": {
      "supported": true
    },
    "gemini": {
      "supported": true
    },
    "codex": {
      "supported": true
    }
  },
  "entrypoints": {
    "spec": "OS.md",
    "system": "SYSTEM.md",
    "skill": "SKILL.md",
    "setup": "SETUP.md",
    "workflows": "WORKFLOWS/",
    "commands": "COMMANDS/",
    "prompts": "PROMPTS/",
    "references": "REFERENCES/",
    "memory": "MEMORY/",
    "tools": "TOOLS/",
    "evals": "EVALS/",
    "examples": "EXAMPLES/",
    "interfaces": "INTERFACES/",
    "adapters": "ADAPTERS/"
  },
  "requires_human_approval_for": [
    "setting or changing a valuation mark",
    "recording or clearing an impairment",
    "sending any report or mark to a stakeholder",
    "committing support capacity with an external cost",
