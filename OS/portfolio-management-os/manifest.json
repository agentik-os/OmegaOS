  },
  "tagline": "Run the portfolio after the deal: reporting, support, reallocation.",
  "inherits_from": null,
  "commands": [
    "/portfolio open",
    "/portfolio collect",
    "/portfolio mark",
    "/portfolio support",
    "/portfolio capacity",
    "/portfolio triage",
    "/portfolio impair",
    "/portfolio followon",
    "/portfolio report",
    "/portfolio exit-ready",
    "/portfolio close"
  ],
  "dependencies": {
