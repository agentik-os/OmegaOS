#!/usr/bin/env bash
# omega-intuition — the OmegaOS command for Intuitive OS (AgentikOS suite,
# personal group; Intuitive {OS}). This OS is conversational (the scoring
# engine is a library, not a state CLI): the wrapper opens a Claude session
# running the Intuitive master agent, working from the OS folder so its
# prediction ledger persists. The training happens in the agent (/intuition),
# or via the OS's Telegram bot.
set -euo pipefail

OMEGA_DIR="${OMEGA_DIR:-$HOME/.omega}"
OS_DIR="$OMEGA_DIR/os/intuitive-os"
mkdir -p "$OS_DIR/ledger"

PERSONA="$OS_DIR/MASTER.md"
[[ -f "$PERSONA" ]] || {
    echo "omega-intuition: no master persona at $PERSONA — run OmegaOS install.sh" >&2
    exit 1
}

cd "$OS_DIR"
exec claude --append-system-prompt "$(cat "$PERSONA")" "$@"
